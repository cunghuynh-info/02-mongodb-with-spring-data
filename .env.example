# Copy to .env and adjust if the defaults clash with something already running.
MONGO_USERNAME=root
MONGO_PASSWORD=example
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# Subset of the Atlas sample dataset to restore (comma separated, no spaces).
# Full list: sample_mflix, sample_airbnb, sample_analytics, sample_training,
# sample_supplies, sample_restaurants, sample_geospatial, sample_weatherdata,
# sample_stats, sample_guides
SAMPLE_DATABASES=sample_mflix,sample_airbnb,sample_analytics,sample_training,sample_supplies

# Set to true for one run to wipe and restore the sample databases again.
SEED_FORCE=false

# --- Security -----------------------------------------------------------------------------
# The plaintext for the three seeded lab accounts (admin@lab.local, analyst@lab.local,
# user@lab.local). The sample_mflix users are real BCrypt hashes of passwords nobody has,
# so without these accounts there is no way to log in.
LAB_SEED_PASSWORD=lab-password

# Base64 PKCS#8 RSA private key used to sign access tokens. Leave it unset and a keypair is
# generated at every startup - which means a devtools restart silently invalidates the token
# sitting in http/requests.http. Set it to keep tokens working across restarts:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER \
#     | openssl base64 -A
#
# The public half is derived from it, so there is only ever one value to manage. Do not commit
# a real key: .env is gitignored, .env.example is not.
LAB_JWT_PRIVATE_KEY=
